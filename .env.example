# Appwrite client configuration
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_ESCROWS_COLLECTION_ID=

# Server-only Appwrite secret. Never expose this with NEXT_PUBLIC_.
APPWRITE_API_KEY=

# Zcash integration mode: demo | testnet | mainnet
ZCASH_NETWORK_MODE=demo

# Optional server-side AI provider key. Never expose to the browser.
AI_ORACLE_API_KEY=

# Optional signer adapter endpoint. Must be a trusted server-side service.
ZCASH_SIGNER_URL=
ZCASH_SIGNER_AUTH_TOKEN=

# HMAC secret for local demo receipts (generate a long random value).
DEMO_RECEIPT_SECRET=
